{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Halo's windows",
  "windows": [
    "main",
    "tray-popover",
    "mini",
    "palette",
    "check-in",
    "reflection",
    "break-overlay-*"
  ],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "notification:default",
    "autostart:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging"
  ]
}
