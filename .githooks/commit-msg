#!/bin/sh
# Conventional Commits: type(scope): subject, e.g. "feat(timer): overflow mode".
msg=$(head -n 1 "$1")
case "$msg" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s' "$msg" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "commit-msg: use Conventional Commits, e.g. 'feat(timer): overflow mode'" >&2
  echo "  got: $msg" >&2
  exit 1
fi
